{
  "name": "rusty-notepad",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "storybook": "ng run rusty-notepad:storybook",
    "build-storybook": "ng run rusty-notepad:build-storybook",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"plan/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.25",
