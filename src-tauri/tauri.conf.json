{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty",
  "version": "0.1.4",
  "identifier": "com.rusty.notepad.windows.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/rusty-notepad/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rusty",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "cli": {
      "description": "Use Rusty cli to open up directories or files directly from terminal",
      "beforeHelp": "Rusty CLI",
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true,
          "multiple": false
        }
      ]
    },
    "shell": {
      "open": true
    }
  }
}
