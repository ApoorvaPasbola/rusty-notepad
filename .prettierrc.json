{
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "overrides": [
    { "files": "*.html", "options": { "parser": "angular" } },
    { "files": "*.md", "options": { "proseWrap": "preserve" } }
  ]
}

